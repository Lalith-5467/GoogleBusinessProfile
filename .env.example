# =============================================================================
# Google Business Profile Application - Full-Stack Monorepo Environment Template
# Copy to .env (or backend/.env and frontend/.env.production as needed)
# NEVER COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# =============================================================================

# =============================================================================
# 1. BACKEND SERVICE (FastAPI / Python)
# =============================================================================
ENVIRONMENT=development
PORT=8000

# MySQL Database Connection String
# Local Development:
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/googlebusinessprofile
# Production Example:
# DATABASE_URL=mysql+pymysql://db_user:strong_password@db-host.internal:3306/googlebusinessprofile

# Frontend Origin (for CORS and OAuth redirect destination)
# Local Development:
FRONTEND_URL=http://localhost:3000
# Production Example:
# FRONTEND_URL=https://yourdomain.com

# Additional Allowed CORS Origins (optional, comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================================================
# 2. GOOGLE OAUTH 2.0 CREDENTIALS
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Required APIs:
#   - My Business Account Management API
#   - My Business Business Information API
#   - Google People API / OAuth2 API
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redirect URI (MUST match Authorized redirect URIs in Google Cloud Console)
# Local Development:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-business/auth/callback
# Production Example:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/google-business/auth/callback

# =============================================================================
# 3. FRONTEND CLIENT (React / Vite)
# Safe for public exposure (bundled into frontend code at build time)
# Leave EMPTY if using same-origin reverse proxy (e.g. Nginx proxying /api/ to backend)
# =============================================================================
# VITE_API_URL=https://api.yourdomain.com
