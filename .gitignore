# =============================================================================
# Root .gitignore - Google Business Profile Full-Stack Application
# =============================================================================

# Node Dependencies & Caches
node_modules/
frontend/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Production Build Outputs
dist/
build/
frontend/dist/
frontend/build/

# Python Compiled Files, Virtual Environments & Caches
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
backend/.venv/
env/
venv/
ENV/

# Playwright Artifacts
test-results/
playwright-report/
.playwright/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Database Dumps & SQLite local files
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log

# IDEs & Operating System Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
