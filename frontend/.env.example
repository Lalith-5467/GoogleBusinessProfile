# Option A: Unified / Same-Domain / Docker Deployment (Recommended)
# Leave blank when frontend & backend share the same domain or reverse proxy.
# All API calls will automatically use relative paths (/api/...).
# VITE_API_URL=

# Option B: Separate Frontend & Backend Domains
