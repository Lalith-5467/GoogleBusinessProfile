# =============================================================================
# Google Business Profile Application - Backend Environment Template
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL (.gitignore protects .env)
# =============================================================================

# Server Environment Mode ('production' or 'development')
ENVIRONMENT=development

# Backend HTTP Port
PORT=8000

# MySQL Database Connection String
# Local Development:
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/googlebusinessprofile
# Production Example (Managed MySQL / RDS / PlanetScale / Railway / VPS):
# DATABASE_URL=mysql+pymysql://db_user:strong_password@db-host.internal:3306/googlebusinessprofile

# Frontend Application Origin (used for CORS and OAuth redirect callback)
# Local Development:
FRONTEND_URL=http://localhost:3000
# Production Example:
# FRONTEND_URL=https://yourdomain.com

# Additional Allowed CORS Origins (comma-separated, optional in production)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# =============================================================================
# Google OAuth 2.0 Credentials (for official Google Business Profile API sync)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# =============================================================================

# Google OAuth 2.0 Web Client ID (Public identifier)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect Callback URI
# MUST match exactly what is registered under "Authorized redirect URIs" in Google Cloud Console!
# Local Development:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-business/auth/callback
# Production Example:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/google-business/auth/callback
